{
  "name": "fivealpha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:signals": "node scripts/check-signals.mjs",
    "check:tickers": "node scripts/check-unknown-tickers.mjs",
    "deploy": "npm run build && wrangler deploy",
    "seed": "node scripts/seed.mjs all",
    "seed:securities": "node scripts/seed.mjs securities",
    "seed:quotes": "node scripts/seed.mjs quotes",
    "check:metrics": "node scripts/check-metrics.mjs",
    "check:listings": "node scripts/check-listings.mjs",
    "check:daycache": "node scripts/check-daycache.mjs",
    "check:upstox": "node scripts/upstox-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.9",
    "wrangler": "^4.28.0"
  }
}
